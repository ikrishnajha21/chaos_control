extends SceneTree

func _init() -> void:
	print(">>> [TEST] Verifying Character Scenes & AnimationPlayers...")
	
	var cw_scene = load("res://assets/characters/crimson_wraith/CrimsonWraith.tscn")
	assert(cw_scene != null, "CrimsonWraith.tscn must load")
	var cw: CharacterVisual = cw_scene.instantiate()
	assert(cw != null, "CrimsonWraith must instantiate as CharacterVisual")
	root.add_child(cw)
	var cw_ap = cw.get_anim_player()
	assert(cw_ap != null, "CrimsonWraith must have anim_player")
	assert(cw_ap.has_animation("idle"), "Must have idle animation")
	assert(cw_ap.has_animation("run"), "Must have run animation")
	assert(cw_ap.has_animation("glitch"), "Must have glitch animation")
	cw.play_idle()
	assert(cw_ap.current_animation == "idle", "Should play idle")
	cw.play_run(1.0)
	assert(cw_ap.current_animation == "run", "Should play run")
	cw.apply_hazard_glitch(true)
	assert(cw_ap.current_animation == "glitch", "Should play glitch")
	cw.apply_hazard_glitch(false)
	cw.queue_free()
	print("✓ CrimsonWraith.tscn and all animations verified")
	
	var cp_scene = load("res://assets/characters/cyan_phantom/CyanPhantom.tscn")
	assert(cp_scene != null, "CyanPhantom.tscn must load")
	var cp: CharacterVisual = cp_scene.instantiate()
	assert(cp != null, "CyanPhantom must instantiate as CharacterVisual")
	root.add_child(cp)
	var cp_ap = cp.get_anim_player()
	assert(cp_ap != null, "CyanPhantom must have anim_player")
	assert(cp_ap.has_animation("idle"), "Must have idle animation")
	assert(cp_ap.has_animation("run"), "Must have run animation")
	assert(cp_ap.has_animation("glitch"), "Must have glitch animation")
	cp.play_idle()
	assert(cp_ap.current_animation == "idle", "Should play idle")
	cp.play_run(1.0)
	assert(cp_ap.current_animation == "run", "Should play run")
	cp.queue_free()
	print("✓ CyanPhantom.tscn and all animations verified")
	
	print(">>> ALL CHARACTER SCENE CHECKS PASSED!")
	quit(0)
