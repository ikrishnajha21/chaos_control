[node name="RulesText" type="Label" parent="Overlays/HowToPlayPanel/VBox/RulesBox/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "• OBJECTIVE RUNNER (CYAN):
  Activate all 3 Control Terminals around the arena. Once complete, the North Extraction Gate unlocks in bright green. Reach the gate before the 120s timer expires to win!

• SABOTEUR (CRIMSON):
  Deploy EMP Disruption Hazards targeting the Runner (1s warning telegraph, 2s active field). Slows and glitches the Runner for 1.5s. Stall the Runner until the 120s timer expires!

• MATCH FORMAT:
  Best-of-3 rounds. Roles automatically switch after every round. Whoever scores 2 points wins the match!"
autowrap_mode = 2

