[node name="RulesText" type="Label" parent="Overlays/HowToPlayPanel/VBox/RulesBox/VBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("3_font_body")
theme_override_font_sizes/font_size = 14
text = "• OBJECTIVE RUNNER (CYAN PHANTOM):
  Navigate the facility and hack all 3 Control Terminals (Node Alpha, Beta, Gamma). Activating nodes rearranges security blast gates and corridors. Once all 3 nodes are online, the Extraction Gate unlocks. Reach the extraction portal before the 120s timer expires to win the round!

• SABOTEUR (CRIMSON WRAITH):
  Deploy localized EMP Disruption Traps, scramble terminals, or overload active laser grids. Glitches and slows the Runner upon contact. Stall the Runner until the 120s round timer expires to win!

• MATCH FORMAT:
  Competitive Best-of-3 rounds. Roles automatically switch after each round. First player to score 2 points wins the match!"
autowrap_mode = 2

